X402_SELLER_ADDRESS=0x...            # carteira de recebimento (só endereço; sem chave no servidor)
X402_FACILITATOR_URL=https://gateway-api-testnet.circle.com   # padrão do SDK = mainnet
X402_NETWORKS=eip155:5042002         # vazio = todas as redes do Gateway
UPSTREAM_BASE_URL=http://localhost:8000/internal/x402
X402_INTERNAL_SECRET=                # igual ao do FastAPI
PUBLIC_URL=https://...
X402_PAUSED=false                    # true = rotas pagas devolvem 503 sem cobrar (runtime: POST /internal/pause)
X402_RATE_LIMIT_PER_MIN=30           # por pagador (ou IP), antes do pagamento

# Comprador (opcional; só liga com a chave). Chave = secret do Railway, nunca no código.
BUYER_PRIVATE_KEY=
X402_CHAIN=arcTestnet                # mainnet = arc
ARC_RPC=https://rpc.testnet.arc.io   # mainnet = https://rpc.mainnet.arc.io
BUYER_MAX_PER_CALL_USDC=0.10
BUYER_DAILY_CAP_USDC=1
